SECRET_KEY=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
PORT=7860
SESSION_COOKIE_SECURE=true

# Optional S3-compatible storage for ERA5 NetCDF files.
# Works with Cloudflare R2, Oracle Object Storage S3 compatibility, Backblaze B2, AWS S3, etc.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# Leave blank if files are uploaded directly in the bucket root.
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
